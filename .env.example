# Root .env for docker-compose
# Copy this file to .env and fill in your actual values
# This file feeds environment variables to BOTH services via env_file: .env

# ── MongoDB Atlas ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nextstop

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Backend ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_at_least_32_random_chars
SUPERADMIN_CREDENTIALS=[{"email":"admin@example.com","password":"yourpassword"}]
CORS_ORIGIN=https://your-frontend-domain.com
