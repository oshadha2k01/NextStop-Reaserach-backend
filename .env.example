# Root .env for docker-compose
# Copy this file to .env and fill in your actual values
# This file feeds environment variables to BOTH services via env_file: .env

# ── MongoDB Atlas ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nextstop
# JourneyModel retrain scripts use MONGODB_URI; keep both set to same value.
MONGODB_URI=${MONGO_URI}
MONGODB_DB_NAME=NextBusDB
MONGODB_SENSOR_COLLECTION=sensor_readings
MONGODB_STOPS_COLLECTION=ml_bus_stops

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── JourneyModel Retraining ────────────────────────────────────
RETRAIN_REALTIME_ENABLED=true
RETRAIN_REALTIME_DEBOUNCE_SECONDS=120
RETRAIN_INTERVAL_HOURS=24
RETRAIN_MIN_NEW_RECORDS=50
MODEL_PROMOTION_MIN_IMPROVEMENT_PCT=2.0
MODEL_PROMOTION_MIN_HOLDOUT_R2=0.10
MODEL_PROMOTION_MIN_BASELINE_IMPROVEMENT_PCT=5.0
MODEL_PROMOTION_MIN_HOLDOUT_SAMPLES=12
MODEL_ROLLBACK_ENABLED=true

# ── Backend ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_at_least_32_random_chars
SUPERADMIN_CREDENTIALS=[{"email":"admin@example.com","password":"yourpassword"}]
CORS_ORIGIN=https://your-frontend-domain.com
