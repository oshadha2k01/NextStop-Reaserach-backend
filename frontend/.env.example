# Environment Configuration for NextStop Frontend
# Copy this file to .env and fill in your actual values

# Backend API URL
VITE_BACKEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# Production example (no trailing slash, no double slash after domain):
# VITE_API_URL=https://smartbusstop.me/backend/api

# Google Maps API Key (for frontend map display)
# Note: This should be a restricted key (HTTP referrer restrictions)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Environment
VITE_ENV=development
# In production: VITE_ENV=production
