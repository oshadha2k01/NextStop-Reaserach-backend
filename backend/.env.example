# Environment Configuration for NextStop Backend
# Copy this file to .env and fill in your actual values

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/nextstop
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nextstop

# Server Port
PORT=3000

# Node Environment: development | production
NODE_ENV=development

# Google Maps Platform API Key
# Required APIs: Distance Matrix API, Directions API
# Get your key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeatherMap API Key
# Get your key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# JWT Secret (for authentication - if implemented)
# JWT_SECRET=your_jwt_secret_here_random_string_min_32_chars
# JWT Secret (min 32 random characters)
JWT_SECRET=your_jwt_secret_here_random_string_min_32_chars

# Super Admin Credentials (JSON array)
SUPERADMIN_CREDENTIALS=[{"email":"admin@example.com","password":"yourpassword"}]

# ML Service URL (Flask)
# Local:      http://localhost:5000
# Docker:     http://ml:5000
# DigitalOcean: set automatically via ${ml.PRIVATE_URL} in app.yaml
ML_SERVICE_URL=http://localhost:5000

# CORS Origin (comma-separated list for production, empty = wildcard in dev)
# Example: https://your-frontend.ondigitalocean.app
CORS_ORIGIN=
